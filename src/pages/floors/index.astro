---
import Layout from "../../layouts/Layout.astro";
import { getEntry, render } from "astro:content";
import { site, floors } from "../../data/site";

const entry = await getEntry("pages", "floor-intro");
const { Content } = await render(entry);
---

<Layout title={`楼层介绍 - ${site.name}`} description="汇通金融大厦楼层介绍：办公用地分低区、中区、高区，商业用地含裙楼1-3层。">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>楼层介绍</h2>
        <p>{floors.intro}</p>
      </div>

      <div class="markdown">
        <Content />
      </div>

      <h3 style="margin: 36px 0 18px; font-size: 1.2rem;">办公用地</h3>
      <div class="grid grid-3">
        {floors.officeZones.map((z) => (
          <div class="card">
            <h3 style="color: var(--primary);">{z.name}</h3>
            <p style="color: var(--accent); font-weight: 600; margin-bottom: 6px;">{z.range}</p>
            <ul>{z.features.map((f) => <li>{f}</li>)}</ul>
          </div>
        ))}
      </div>

      <h3 style="margin: 36px 0 18px; font-size: 1.2rem;">商业用地</h3>
      <div class="grid grid-3">
        {floors.commercialZones.map((z) => (
          <div class="card">
            <h3 style="color: var(--primary);">{z.name}</h3>
            <p style="color: var(--accent); font-weight: 600; margin-bottom: 6px;">{z.usage}</p>
            <ul>{z.features.map((f) => <li>{f}</li>)}</ul>
          </div>
        ))}
      </div>

      <div class="card" style="margin-top: 36px; padding: 0; overflow: hidden;">
        <img src={floors.lobbyImage} alt={floors.lobbyImageAlt} style="width: 100%; max-height: 460px; object-fit: cover;" />
      </div>
      <p style="margin-top: 14px; color: var(--text-secondary); font-size: 0.88rem; text-align: center;">
        {floors.lobbyImageAlt}｜{floors.note}
      </p>
    </div>
  </section>
</Layout>
