---
import Layout from "../../layouts/Layout.astro";
import { getEntry, render } from "astro:content";
import { site, businessFormats } from "../../data/site";

const entry = await getEntry("pages", "format-intro");
const { Content } = await render(entry);

const icons = ["🏦", "🏛️", "🌐", "", "⚖️"];
---

<Layout title={`业态规划 - ${site.name}`} description="汇通金融大厦业态规划：金融机构、国企总部、外资企业、数字科技、专业服务五大业态。">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>业态规划</h2>
        <p>{businessFormats.intro}</p>
      </div>

      <div class="markdown">
        <Content />
      </div>

      <div class="grid grid-3" style="margin-top: 28px;">
        {businessFormats.formats.map((f, i) => (
          <div class="card" style="text-align: center;">
            <div style="font-size: 2rem; margin-bottom: 8px;">{icons[i]}</div>
            <h3>{f.name}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
